{
  "name": "dsh-bonk-pet",
  "version": "0.12.0",
  "description": "敲盆宠物 —— DSH Web GUI 的悬浮小鲸鱼：agent 执行出错时从天上掉钢管砸它，你可以敲它的铁盆，敲完它会去讨白饭吃。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "files": [
    "lib/",
    "assets/",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "pet",
    "desktop-pet",
    "mascot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reisen-ww/dsh-bonk-pet.git"
  },
  "homepage": "https://github.com/reisen-ww/dsh-bonk-pet#readme",
  "bugs": {
    "url": "https://github.com/reisen-ww/dsh-bonk-pet/issues"
  }
}
